{
    // Use 'npx teeny' commands instead of 'npx wrangler' — teeny wraps wrangler with auto-resource creation and auth.
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "backend",
    "account_id": "1c42df17423ee690be99392eb2f342f2",
    "main": "src/index.ts",
    "compatibility_date": "2026-05-26",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true,
        "logs": {
            "invocation_logs": true,
            "head_sampling_rate": 1
        }
    },
    "vars": { "RESPOND_WITH_ERRORS": "true" },
    "d1_databases": [
        {
            "binding": "PRIMARY_DB",
            "database_name": "backend-db",
            "database_id": "4630569c-7b18-410d-8016-90238427ab2e",
            "migrations_dir": "migrations"
        }
    ]
}
